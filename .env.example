# Backend API base URL.
VITE_APP_SERVER_URL=http://localhost:5001/api

# Solana network for the whole frontend: devnet (default) or mainnet. Must match the backend's SOLANA_CLUSTER.
VITE_SOLANA_NETWORK=devnet

# Optional: your RPC provider URL (Helius, QuickNode...). Defaults to the public RPC of the network above.
VITE_SOLANA_RPC_URL=
